{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Release)",
            "description": "Standard release build for the host platform",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "dev",
            "displayName": "Development (Debug)",
            "inherits": "default",
            "description": "Debug build with tests enabled",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "with-tests",
            "displayName": "Release with Tests",
            "inherits": "default",
            "cacheVariables": {
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "windows-cross",
            "displayName": "Windows x64 (MinGW cross-compile)",
            "description": "Cross-compile for Windows from Linux via MinGW",
            "binaryDir": "${sourceDir}/build-windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_SYSTEM_NAME": "Windows",
                "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
                "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
                "CMAKE_FIND_ROOT_PATH": "/usr/x86_64-w64-mingw32",
                "CMAKE_FIND_ROOT_PATH_MODE_PROGRAM": "NEVER",
                "CMAKE_FIND_ROOT_PATH_MODE_LIBRARY": "ONLY",
                "CMAKE_FIND_ROOT_PATH_MODE_INCLUDE": "ONLY"
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-static",
            "displayName": "Linux static musl",
            "description": "Fully static musl build (Alpine container)",
            "binaryDir": "${sourceDir}/build-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXE_LINKER_FLAGS": "-static"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "description": "Build with default preset"
        },
        {
            "name": "dev",
            "configurePreset": "dev",
            "description": "Build debug with tests"
        },
        {
            "name": "with-tests",
            "configurePreset": "with-tests",
            "description": "Build release with tests"
        },
        {
            "name": "windows-cross",
            "configurePreset": "windows-cross",
            "description": "Build for Windows via cross-compile"
        },
        {
            "name": "linux-static",
            "configurePreset": "linux-static",
            "description": "Build static musl Linux binary"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "with-tests",
            "description": "Run unit tests",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
